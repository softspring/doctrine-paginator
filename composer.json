{
    "name": "softspring/doctrine-paginator",
    "description": "This library provides a paginator for doctrine query builder",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^2.11 | ^3.0",
        "doctrine/collections": "^1.8 | ^2.0 | ^3.0",
        "softspring/doctrine-query-filters": "^6.0@dev",
        "symfony/http-foundation": "^6.4|^7.3",
        "symfony/form": "^6.4|^7.3",
        "symfony/validator": "^6.4|^7.3",
        "symfony/routing": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DoctrinePaginator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\DoctrinePaginator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
